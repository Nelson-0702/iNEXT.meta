\name{Spider_distM}
\alias{Spider_distM}
\docType{data}
\title{
  Species pairwise distance matrix for spider abundance data
}
\description{
  This dataset includes a species pairwise distance matrix for species listed
  in the \code{Spider_abundance_data} dataset.
}
\usage{data(Spider_distM)}
\format{
  \code{Spider_distM} is a symmetric species-by-species distance matrix.
  Each element represents the functional distance between two species.
}
\keyword{datasets}