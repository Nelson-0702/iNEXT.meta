\name{Hoverfly_distM}
\alias{Hoverfly_distM}
\docType{data}
\title{
  Species pairwise functional distance matrix for hoverfly data
}
\description{
  This dataset includes a species pairwise functional distance matrix
  for species listed in the \code{Hoverfly} dataset.
}
\usage{data(Hoverfly_distM)}
\format{
  \code{Hoverfly_distM} is a symmetric species-by-species distance matrix.
  Each element represents the functional distance between two species.
}
\keyword{datasets}
